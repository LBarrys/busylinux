#!/bin/sh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mountpoint -q /proc || mount -t proc     proc     /proc
mountpoint -q /sys  || mount -t sysfs    sysfs    /sys
mountpoint -q /dev  || mount -t devtmpfs devtmpfs /dev
mountpoint -q /run  || mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mkdir -p /dev/pts /dev/shm /run/lock
mountpoint -q /dev/pts || mount -t devpts -o gid=5,mode=620 devpts /dev/pts
mountpoint -q /dev/shm || mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
mkdir -p /run/user && chmod 1777 /run/user
if [ -d /sys/firmware/efi/efivars ] && ! mountpoint -q /sys/firmware/efi/efivars; then
    mount -t efivarfs -o nosuid,nodev,noexec efivarfs /sys/firmware/efi/efivars
fi
if ! mountpoint -q /sys/fs/cgroup; then
    mount -t cgroup2 -o nosuid,nodev,noexec,nsdelegate cgroup2 /sys/fs/cgroup
    for c in $(cat /sys/fs/cgroup/cgroup.controllers); do
        echo "+$c" > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || :
    done
fi

read -r root_dev root_fs root_opts <<EOF
$(awk '$2 == "/" { print $1, $3, $4; exit }' /proc/mounts)
EOF
case ",$root_opts," in
    *,ro,*)
        if [ "$root_fs" = ext4 ] && command -v fsck.ext4 > /dev/null 2>&1; then
            echo "Checking $root_dev"
            fsck.ext4 -p "$root_dev"
            case $? in
                0|1) ;;
                2)   echo "Repaired; rebooting"; sleep 2; reboot -f ;;
                *)   echo "fsck.ext4 could not repair $root_dev without help."
                     echo "Run 'fsck.ext4 $root_dev', then 'exit' to carry on."
                     setsid cttyhack sh ;;
            esac
        fi ;;
esac

mount -o remount,rw /
mount -a

hostname -F /etc/hostname
dmesg -n 3

for keymap in /etc/keymap/*.bmap.gz; do
    [ -f "$keymap" ] && zcat "$keymap" | loadkmap
    break
done

for conf in /etc/sysctl.d/*.conf /etc/sysctl.conf; do
    [ -f "$conf" ] && sysctl -e -q -p "$conf"
done

if [ -x /sbin/udevd ]; then
    udevd -d
    udevadm trigger --type=subsystems --action=add
    udevadm trigger --type=devices --action=add
    udevadm settle -t 10
else
    mdev -d
fi

for conf in /etc/modules-load.d/*.conf /usr/lib/modules-load.d/*.conf; do
    [ -f "$conf" ] || continue
    while read -r module _; do
        case $module in ''|'#'*) continue ;; esac
        modprobe "$module" 2>/dev/null || :
    done < "$conf"
done

# The device manager applies its own table to every node it finds; give these
# the modes their users need: KVM for the kvm group, Wine's NT sync objects
# for everyone (the kernel's own choice), uinput for the input group (Steam).
if [ -c /dev/kvm ]; then chgrp kvm /dev/kvm && chmod 660 /dev/kvm; fi
if [ -c /dev/ntsync ]; then chmod 666 /dev/ntsync; fi
if [ -c /dev/uinput ]; then chgrp input /dev/uinput && chmod 660 /dev/uinput; fi

# The firewall fails closed: /etc/service/dhcp brings no interface up while
# /etc/nftables.conf exists and no ruleset is loaded.
if [ -f /etc/nftables.conf ]; then
    if ! command -v nft > /dev/null 2>&1; then
        echo "rcS: nft is missing; the network stays down"
    elif ! nft -f /etc/nftables.conf; then
        echo "rcS: /etc/nftables.conf did not load; the network stays down"
    fi
fi

ip link set lo up

# TRIM every ext4 file system once, a minute after boot.
(sleep 60
 awk '$3 == "ext4" { print $2 }' /proc/mounts | while read -r mp; do
     fstrim "$mp" || :
 done) > /dev/null 2>&1 &
