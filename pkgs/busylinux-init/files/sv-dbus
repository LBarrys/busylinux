#!/bin/sh
# dbus-daemon logs to syslog itself.
# Until syslogd listens, its messages would go to the console.
[ -S /dev/log ] || exec sleep 1
exec > /dev/null 2>&1
command -v dbus-daemon > /dev/null 2>&1 || exec sleep 3600
mkdir -p /run/dbus
dbus-uuidgen --ensure || :
exec dbus-daemon --system --nofork --nopidfile
