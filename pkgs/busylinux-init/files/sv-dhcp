#!/bin/sh
# udhcpc logs to syslog itself (-S).
# Until syslogd listens, its messages would go to the console.
[ -S /dev/log ] || exec sleep 1
exec > /dev/null 2>&1
# Fail closed: no network while nftables.conf exists and no ruleset is loaded.
if [ -f /etc/nftables.conf ] && [ -z "$(nft list ruleset 2>/dev/null)" ]; then
    logger -t dhcp "no firewall ruleset is loaded; not bringing the network up"
    exec sleep 30
fi
for dev in /sys/class/net/*; do
    name=${dev##*/}
    # Network cards only: bridges and veths have no device behind them.
    [ -e "$dev/device" ] || continue
    [ "$(cat "$dev/type" 2>/dev/null)" = 1 ] || continue
    # IPv6 addresses from random bits, not the card's MAC, changed daily.
    echo 3 > "/proc/sys/net/ipv6/conf/$name/addr_gen_mode" 2>/dev/null
    echo 2 > "/proc/sys/net/ipv6/conf/$name/use_tempaddr" 2>/dev/null
    ip link set "$name" up
    # -V '': no "udhcp VERSION" vendor string telling the network the OS.
    # shellcheck disable=SC2093
    exec udhcpc -f -S -V '' -i "$name"
done
exec sleep 10
