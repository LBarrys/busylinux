From 2113430ae2fdd485d637e95b95b6752746348932 Mon Sep 17 00:00:00 2001
From: LBarrys <lbarrys@local>
Date: Fri, 9 Oct 2026 09:40:58 +0000
Subject: [PATCH] attachbottom (dwl-patches): new windows go to the end of the
 stack

---
 dwl.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/dwl.c b/dwl.c
index f16d8c3..1650105 100644
--- a/dwl.c
+++ b/dwl.c
@@ -2244,7 +2244,11 @@ mapnotify(struct wl_listener *listener, void *data)
 	c->geom.height += 2 * c->bw;
 
 	/* Insert this client into client lists. */
-	wl_list_insert(&clients, &c->link);
+	if (clients.prev)
+		// tile at the bottom
+		wl_list_insert(clients.prev, &c->link);
+	else
+		wl_list_insert(&clients, &c->link);
 	wl_list_insert(&fstack, &c->flink);
 
 	c->foreign_toplevel_handle = wlr_ext_foreign_toplevel_handle_v1_create(
-- 
2.43.0

