#!/bin/sh -e
# Four small C programs; libmupdf, libarchive and zlib become dependencies by themselves.
cc $CFLAGS -O2 -Wall -o lbsfm lbsfm.c
cc $CFLAGS -O2 -Wall -o lbsviewer lbsviewer.c -lmupdf -lm -lpthread
cc $CFLAGS -O2 -Wall -o lbsx lbsx.c -larchive
cc $CFLAGS -O2 -Wall -o lbsshot lbsshot.c -lz
for p in lbsfm lbsviewer lbsx lbsshot; do
    install -Dm755 "$p" "$1/usr/bin/$p"
done
