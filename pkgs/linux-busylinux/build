#!/bin/sh -e
make -s tinyconfig > /dev/null

fragments=busylinux.config
[ "${VM_SUPPORT:-0}" = 1 ] && fragments="$fragments vm.config"
./scripts/kconfig/merge_config.sh -m -Q .config $fragments > /dev/null
make -s olddefconfig
# The Ethernet vendor menus default on; only Realtek's is needed.
sed -i '/REALTEK/!s/^CONFIG_\(NET_VENDOR_.*\)=y$/# CONFIG_\1 is not set/' .config
make -s olddefconfig

if [ "${MENUCONFIG:-0}" = 1 ]; then make menuconfig; fi

missing=
for symbol in MODULES BLK_DEV_INITRD DEVTMPFS_MOUNT EFI_STUB EFI_PARTITION \
              BLOCK PCI NET INET UNIX PACKET MULTIUSER BINFMT_ELF PROC_SYSCTL \
              EPOLL SIGNALFD TIMERFD FUTEX SHMEM INOTIFY_USER \
              FILE_LOCKING MEMFD_CREATE FHANDLE RSEQ KCMP \
              TTY VT UNIX98_PTYS SERIAL_8250_CONSOLE FRAMEBUFFER_CONSOLE \
              BLK_DEV_NVME SATA_AHCI EXT4_FS VFAT_FS USB_XHCI_PCI \
              INPUT_EVDEV HID_GENERIC \
              DRM_AMDGPU DRM_AMD_DC SND_USB_AUDIO \
              R8169 X86_AMD_PSTATE MICROCODE X86_X2APIC \
              IA32_EMULATION COMPAT COMPAT_32BIT_TIME MODIFY_LDT_SYSCALL X86_16BIT \
              USER_NS SECCOMP FUSE_FS OVERLAY_FS LRU_GEN LRU_GEN_ENABLED ZRAM ZRAM_DEF_COMP_ZSTD \
              CPU_MITIGATIONS MITIGATION_RETPOLINE MITIGATION_SRSO \
              STACKPROTECTOR_STRONG FORTIFY_SOURCE HARDENED_USERCOPY VMAP_STACK \
              SLAB_FREELIST_RANDOM SLAB_FREELIST_HARDENED SHUFFLE_PAGE_ALLOCATOR \
              INIT_ON_ALLOC_DEFAULT_ON BUG_ON_DATA_CORRUPTION SCHED_STACK_END_CHECK \
              SECURITY SECURITY_YAMA SECURITY_DMESG_RESTRICT MODULE_SIG_FORCE \
              SYN_COOKIES MAGIC_SYSRQ EFIVAR_FS \
              NETFILTER NF_TABLES NF_CONNTRACK WIREGUARD \
              NTSYNC JOYSTICK_XPAD INPUT_JOYDEV INPUT_UINPUT DMIID HSA_AMD HSA_AMD_SVM \
              CGROUP_BPF BPF_SYSCALL CGROUP_PIDS CPUSETS \
              VETH BRIDGE NF_NAT NFT_NAT NFT_MASQ NFT_COMPAT \
              NETFILTER_XT_MATCH_ADDRTYPE NETFILTER_XT_MATCH_CONNTRACK \
              NETFILTER_XT_NAT NETFILTER_XT_TARGET_MASQUERADE; do
    grep -q "^CONFIG_$symbol=[ym]" .config || missing="$missing $symbol"
done
[ -z "$missing" ] || { printf 'config lost:%s\n' "$missing" >&2; exit 1; }

crept=
for symbol in CPU_SUP_INTEL CPU_SUP_HYGON CPU_SUP_CENTAUR CPU_SUP_ZHAOXIN \
              SLUB_TINY WLAN BT IPV6_SIT ISO9660_FS INPUT_MOUSE \
              SND_HDA_CORE SND_HDA_INTEL \
              KVM VHOST_NET USERFAULTFD INTEL_MEI ACPI_BATTERY VGA_CONSOLE \
              LEGACY_PTYS LEGACY_TIOCSTI LDISC_AUTOLOAD RD_ZSTD; do
    if grep -q "^CONFIG_$symbol=[ym]" .config; then crept="$crept $symbol"; fi
done
[ -z "$crept" ] || { printf 'config crept back:%s\n' "$crept" >&2; exit 1; }

printf 'kernel: %s options enabled\n' "$(grep -c '=y$\|=m$' .config)"

make bzImage modules
release=$(make -s kernelrelease)
make -s INSTALL_MOD_PATH="$1" INSTALL_MOD_STRIP=1 modules_install
rm -f "$1/lib/modules/$release/build" "$1/lib/modules/$release/source"
install -Dm644 arch/x86/boot/bzImage "$1/boot/vmlinuz-busylinux"
install -Dm644 .config "$1/boot/config-$release"
