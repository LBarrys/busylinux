# Virtual-machine drivers, so the same kernel boots under QEMU/KVM for testing
# before it ever touches the real machine. Drop this fragment (VM_SUPPORT=0)
# for a kernel that only knows your hardware.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
