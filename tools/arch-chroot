#!/bin/sh
# An Arch Linux tree for Steam and other glibc programs, entered with bubblewrap.
set -eu

usage() {
    cat <<'EOT'
    arch-chroot update               the keyring, then pacman -Syu, then a cache cleanup
    arch-chroot pacman ARGS...       pacman in the tree, e.g. -S mangohud
    arch-chroot root [COMMAND...]    a root shell or command in the tree
    arch-chroot [run] COMMAND...     COMMAND in the tree as you, e.g. steam

The tree is /opt/root.x86_64 (ARCH_ROOT to change it); tools/arch-setup
makes it. Root commands go through doas.
EOT
}

R=${ARCH_ROOT:-/opt/root.x86_64}
die() { printf 'arch-chroot: %s\n' "$*" >&2; exit 1; }
as_root() { [ "$(id -u)" = 0 ] || exec doas env ARCH_ROOT="$R" "$0" "$@"; }

# Root in the tree. --cap-add ALL lets pacman switch to its download user,
# which Landlock then confines to the download folder.
in_root() {
    # Mount points for run, which sees the tree read-only.
    mkdir -p "$R/mnt" "$R/media"
    [ -e "$R/etc/localtime" ] || [ -L "$R/etc/localtime" ] || : > "$R/etc/localtime"
    exec bwrap --cap-add ALL --bind "$R" / --dev /dev --proc /proc \
        --ro-bind /etc/resolv.conf /etc/resolv.conf -- "$@"
}

# You in the tree: your home, drives, devices, display and PipeWire. The tree's
# glibc cannot load musl's mimalloc, hence no LD_PRELOAD.
run() {
    [ -d "$R" ] || die "no tree at $R; run tools/arch-setup first"
    u=/run/user/$(id -u)
    # Mount points must exist in the read-only tree; root commands make them.
    mnt='' media=''
    [ ! -d "$R/mnt" ] || mnt=/mnt
    [ ! -d "$R/media" ] || media=/media
    # Arch's newer fontconfig gets its own cache; Alpine's refuses newer caches.
    fc=${XDG_CACHE_HOME:-$HOME/.cache}/fontconfig
    mkdir -p "$fc-arch" "$fc"
    # Your time zone, when both sides have the file.
    lt=''
    [ ! -e /etc/localtime ] || [ ! -e "$R/etc/localtime" ] || lt=/etc/localtime
    # The locale arch-setup generates, unless you chose one.
    [ -n "${LANG:-}" ] || export LANG=en_US.UTF-8
    # Mesa keeps 1 GB of compiled shaders by default; Proton games need 1-3 GB
    # each, and an evicted shader means a stutter when it is compiled again.
    [ -n "${MESA_SHADER_CACHE_MAX_SIZE:-}" ] || export MESA_SHADER_CACHE_MAX_SIZE=10G
    # The tree's libudev waits for udevd, which this system lacks, so SDL would
    # find no controllers, Steam Input's virtual ones included; SDL scans
    # /dev/input itself instead.
    [ -n "${SDL_JOYSTICK_DISABLE_UDEV:-}" ] || export SDL_JOYSTICK_DISABLE_UDEV=1
    # shellcheck disable=SC2086
    exec bwrap --ro-bind "$R" / \
        --dev-bind /dev /dev --proc /proc --ro-bind /sys /sys --bind /tmp /tmp \
        --tmpfs /home --tmpfs /run \
        --bind "$HOME" "$HOME" --bind "$fc-arch" "$fc" --bind-try "$u" "$u" \
        ${mnt:+--bind-try $mnt $mnt} ${media:+--bind-try $media $media} --unsetenv LD_PRELOAD \
        --ro-bind /etc/passwd /etc/passwd --ro-bind /etc/group /etc/group \
        --ro-bind /etc/resolv.conf /etc/resolv.conf \
        --ro-bind-try /etc/machine-id /etc/machine-id \
        ${lt:+--ro-bind $lt $lt} \
        -- "$@"
}

case ${1:-} in
    ''|-h|--help) usage ;;
    # The keyring first: a tree left for weeks cannot check newer signatures.
    # -Sc then keeps only the installed versions in the package cache.
    update) as_root "$@"; [ -d "$R" ] || die "no tree at $R"
            in_root /bin/sh -c 'pacman -Sy --needed --noconfirm archlinux-keyring &&
                pacman -Su && pacman -Sc --noconfirm' ;;
    pacman) as_root "$@"; shift; [ -d "$R" ] || die "no tree at $R"
            in_root pacman "$@" ;;
    root)   as_root "$@"; shift; [ -d "$R" ] || die "no tree at $R"
            [ $# -gt 0 ] || set -- /bin/bash
            in_root "$@" ;;
    run)    shift; [ $# -gt 0 ] || die "run what?"; run "$@" ;;
    *)      run "$@" ;;
esac
