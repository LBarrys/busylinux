#!/bin/sh
# Sets up the Arch Linux tree for Steam once; run as your user.
set -eu

usage() {
    cat <<'EOT'
    arch-setup [PACKAGE...]

Downloads Arch's bootstrap tree into /opt/root.x86_64 (ARCH_ROOT to change it),
checks its checksum, enables multilib and installs Steam, umu-launcher,
MangoHud and the Radeon Vulkan drivers, or PACKAGE... instead. Then installs
arch-chroot into ~/.local/bin and a Steam entry for launchers.
Root steps go through doas. Afterwards: arch-chroot steam.
EOT
}

R=${ARCH_ROOT:-/opt/root.x86_64}
MIRROR=https://geo.mirror.pkgbuild.com
TOOLS=$(cd "$(dirname "$0")" && pwd -P)
die() { printf 'arch-setup: %s\n' "$*" >&2; exit 1; }

# As root: the tree itself.
tree() {
    command -v bwrap > /dev/null && command -v zstd > /dev/null || apk add -q bubblewrap zstd
    tmp=$(mktemp -d /var/tmp/arch-setup.XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    echo "Downloading Arch Linux"
    (cd "$tmp"
     wget -q "$MIRROR/iso/latest/archlinux-bootstrap-x86_64.tar.zst"
     wget -q "$MIRROR/iso/latest/sha256sums.txt"
     grep ' archlinux-bootstrap-x86_64.tar.zst$' sha256sums.txt | sha256sum -c -) ||
        die "download or checksum failed"
    zstd -dc "$tmp/archlinux-bootstrap-x86_64.tar.zst" | tar -x -C "$tmp"
    mkdir -p "${R%/*}"
    mv "$tmp/root.x86_64" "$R"
    rm -rf "$tmp"
    trap - EXIT

    sed -i 's|^#Server = https://geo|Server = https://geo|' "$R/etc/pacman.d/mirrorlist"
    sed -i '/^#\[multilib\]/,/^#Include/ s/^#//; s/^CheckSpace/#CheckSpace/' "$R/etc/pacman.conf"
    sed -i 's/^#en_US.UTF-8/en_US.UTF-8/' "$R/etc/locale.gen"
    touch "$R/etc/machine-id"
    mkdir -p "$R/mnt" "$R/media"
    [ -e "$R/etc/localtime" ] || [ -L "$R/etc/localtime" ] || : > "$R/etc/localtime"
    [ $# -gt 0 ] || set -- steam umu-launcher mangohud lib32-mangohud \
        vulkan-radeon lib32-vulkan-radeon lib32-mesa
    # --cap-add ALL lets pacman switch to its download user (Landlock-confined).
    bwrap --cap-add ALL --bind "$R" / --dev /dev --proc /proc \
        --ro-bind /etc/resolv.conf /etc/resolv.conf -- /bin/sh -c '
        pacman-key --init && pacman-key --populate archlinux &&
        locale-gen && pacman -Syu --noconfirm "$@"' sh "$@"
}

case ${1:-} in
    -h|--help) usage; exit 0 ;;
    --tree)    [ "$(id -u)" = 0 ] || die "--tree is the root half"
               shift; tree "$@"; exit 0 ;;
esac
[ "$(id -u)" != 0 ] || die "run this as your user; it asks doas for the root steps"

if [ -d "$R" ]; then
    echo "$R exists already; arch-chroot update updates it."
else
    doas env ARCH_ROOT="$R" "$TOOLS/arch-setup" --tree "$@"
fi

install -Dm755 "$TOOLS/arch-chroot" "$HOME/.local/bin/arch-chroot"
desktop=$HOME/.local/share/applications/steam.desktop
if [ ! -e "$desktop" ]; then
    mkdir -p "${desktop%/*}"
    cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Steam
Exec=$HOME/.local/bin/arch-chroot /usr/bin/steam %U
Icon=steam
Terminal=false
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
PrefersNonDefaultGPU=true
EOF
fi
echo "Done: arch-chroot steam, or Steam from your launcher."
